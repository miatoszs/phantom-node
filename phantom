def cmd_status():
    print_banner()
    tor_active = tor_mgr.is_tor_active()
    tor_status = "\033[32mActive (v3 Hidden Services Ready)\033[0m" if tor_active else "\033[31mInactive\033[0m"
    opsec_status = opsec_mgr.get_opsec_status()
    usb_status = "\033[32mARMED\033[0m" if opsec_status["usb_switch_armed"] else "\033[33mDisarmed\033[0m"

    print(f"  \033[1mTor Network:\033[0m           {tor_status}")
    print(f"  \033[1mUSB Dead Man's Switch:\033[0m {usb_status}")
    print(f"  \033[1mUFW WAN Shield:\033[0m        {'\033[32mActive\033[0m' if opsec_status['ufw_active'] else '\033[33mInactive\033[0m'}")
    print(f"  \033[1mKernel Hardening:\033[0m      {'\033[32mApplied\033[0m' if opsec_status['sysctl_hardened'] else '\033[33mDefault\033[0m'}")

    apps = docker_mgr.list_available_apps()
    installed = [a for a in apps if a.get("is_installed")]
    print(f"\n  \033[1mInstalled Applications ({len(installed)}):\033[0m")
    for app in installed:
        status_color = "\033[32m[Running]\033[0m" if app.get("is_running") else "\033[31m[Stopped]\033[0m"
        onion = app.get("onion") or "No onion"
        print(f"    - \033[1m{app['id']}\033[0m ({app['name']}): {status_color} -> http://{onion}")

def cmd_app(args):
    if not args:
        show_help()
        return

    sub = args[0]
    if sub == "list":
        apps = docker_mgr.list_available_apps()
        print("\n\033[1m=== PhantomNode Privacy App Catalog ===\033[0m\n")
        print(f"{'ID':<18} {'NAME':<28} {'CATEGORY':<18} {'OPSEC':<10} {'STATUS'}")
        print("-" * 85)
        for a in apps:
            if a.get("is_installed"):
                st = "\033[32mInstalled (Running)\033[0m" if a.get("is_running") else "\033[33mInstalled (Stopped)\033[0m"
            else:
                st = "Available"
            print(f"{a['id']:<18} {a['name']:<28} {a['category']:<18} {a['opsec_level']:<10} {st}")
    elif sub == "install":
        if len(args) < 2:
            print("[!] Please specify app_id: phantom app install <app_id> [--port <port>] [--advanced]")
            return
        app_id = args[1]
        custom_config = {}

        if "--port" in args:
            try:
                p_idx = args.index("--port") + 1
                custom_config["web_port"] = int(args[p_idx])
            except Exception:
                print("[!] Invalid --port value.")
                return

        if "--advanced" in args:
            manifest = docker_mgr.get_app_manifest(app_id) or {}
            web_label = manifest.get("web_port_label", "Local Web Port")
            def_web = manifest.get("web_port", 80)
            def_onion = manifest.get("onion_port", 80)
            print(f"\n\033[1m--- Advanced Installation: {app_id} ---\033[0m")
            in_port = input(f"Custom {web_label} [{def_web}]: ").strip()
            if in_port:
                try:
                    custom_config["web_port"] = int(in_port)
                except ValueError:
                    pass
            in_onion = input(f"Custom Tor Onion Port [{def_onion}]: ").strip()
            if in_onion:
                try:
                    custom_config["onion_port"] = int(in_onion)
                except ValueError:
                    pass

            extra_ports = manifest.get("extra_ports", [])
            if extra_ports:
                custom_config["extra_ports"] = {}
                for ep in extra_ports:
                    ep_key = ep.get("key")
                    ep_label = ep.get("label", ep_key)
                    ep_def = ep.get("default")
                    in_ep = input(f"Custom {ep_label} [{ep_def}]: ").strip()
                    if in_ep:
                        try:
                            custom_config["extra_ports"][ep_key] = int(in_ep)
                        except ValueError:
                            pass
                    else:
                        custom_config["extra_ports"][ep_key] = ep_def

            print("Enter custom .env variables (empty line to finish):")
            env_lines = []
            while True:
                line = input(" > ").strip()
                if not line:
                    break
                env_lines.append(line)
            if env_lines:
                custom_config["custom_env"] = "\n".join(env_lines)

        print(f"[*] Installing {app_id}...")
        res = docker_mgr.install_app(app_id, custom_config=custom_config if custom_config else None)
        if res.get("success"):
            print(f"\033[32m[+] Successfully installed {app_id}!\033[0m")
            if res.get("onion"):
                print(f"[*] Tor .onion URL: http://{res['onion']}")
            print(f"[*] Local LAN Port: {res.get('web_port')}")
        else:
            print(f"\033[31m[!] Error: {res.get('error')}\033[0m")
    elif sub in ["start", "stop", "restart"]:
        if len(args) < 2:
            print(f"[!] Please specify app_id: phantom app {sub} <app_id>")
            return
        app_id = args[1]
        fn = getattr(docker_mgr, f"{sub}_app")
        res = fn(app_id)
        print(f"[*] App {app_id} {sub} result: {'Success' if res.get('success') else res.get('error')}")
    elif sub == "update":
        if len(args) < 2:
            print("[!] Please specify app_id: phantom app update <app_id> (or 'phantom app update-all')")
            return
        app_id = args[1]
        print(f"[*] Pulling latest Docker image and updating '{app_id}'...")
        res = docker_mgr.update_app(app_id)
        if res.get("success"):
            print(f"\033[32m[+] {res.get('message')}\033[0m")
        else:
            print(f"\033[31m[!] Error: {res.get('error')}\033[0m")
    elif sub in ["update-all", "upgrade-all"]:
        print("[*] Pulling latest images and updating all installed containers...")
        res = docker_mgr.update_all_apps()
        if res.get("total", 0) == 0:
            print("[*] No applications are currently installed.")
            return
        print(f"\033[32m[+] Updated {res.get('updated')}/{res.get('total')} installed applications.\033[0m")
        for aid, r in res.get("results", {}).items():
            st = "\033[32m[Updated]\033[0m" if r.get("success") else f"\033[31m[Failed: {r.get('error')}]\033[0m"
            print(f"  - {aid}: {st}")
    elif sub == "remove":
        if len(args) < 2:
            print("[!] Please specify app_id: phantom app remove <app_id>")
            return
        app_id = args[1]
        confirm = input(f"Are you sure you want to remove '{app_id}'? (y/N): ")
        if confirm.lower() == 'y':
            res = docker_mgr.remove_app(app_id)
            print(f"[*] {res.get('message', res.get('error'))}")
    elif sub == "logs":
        if len(args) < 2:
            print("[!] Please specify app_id: phantom app logs <app_id>")
            return
        app_id = args[1]
        print(docker_mgr.get_logs(app_id, lines=50))
    else:
        show_help()

def cmd_onion():
    services = tor_mgr.list_services()
    print("\n\033[1m=== PhantomNode Active Tor v3 Hidden Services ===\033[0m\n")
    if not services:
        print("  No hidden services found.")
        return
    for s in services:
        print(f"  \033[36m{s['service_id']:<20}\033[0m -> http://{s['onion']}")

def cmd_opsec(args):
    if not args or args[0] == "status":
        st = opsec_mgr.get_opsec_status()
        print("\n\033[1m=== PhantomNode OPSEC & Anti-Forensics Status ===\033[0m\n")
        print(f"  USB Dead Man's Switch (nukeusb): {'\033[32mARMED\033[0m' if st['usb_switch_armed'] else '\033[33mDisarmed\033[0m'}")
        print(f"  HID Tamper Trap:                {'\033[32mARMED\033[0m' if st['hid_trap_armed'] else '\033[33mDisarmed\033[0m'}")
        print(f"  UFW Firewall (Zero WAN):        {'\033[32mActive\033[0m' if st['ufw_active'] else '\033[31mInactive\033[0m'}")
        print(f"  Kernel Sysctl Hardening:        {'\033[32mApplied\033[0m' if st['sysctl_hardened'] else '\033[33mDefault\033[0m'}")
    elif args[0] == "arm-usb":
        res = opsec_mgr.set_usb_switch(True)
        print(f"[*] {res.get('message', res.get('error'))}")
    elif args[0] == "disarm-usb":
        res = opsec_mgr.set_usb_switch(False)
        print(f"[*] {res.get('message', res.get('error'))}")
    elif args[0] == "panic":
        confirm = input("\033[31m[DANGER] This will IMMEDIATELY flush RAM caches and power off the machine! Proceed? (yes/NO): \033[0m")
        if confirm == "yes":
            opsec_mgr.trigger_panic("poweroff")
    else:
        show_help()

def cmd_update(args):
    if args and args[0] == "check":
        print("[*] Checking for PhantomNode OS updates...")
        res = system_mgr.check_for_updates()
        if not res.get("success"):
            print(f"\033[31m[!] Error: {res.get('error')}\033[0m")
            return
        if res.get("update_available"):
            print(f"\033[33m[*] Update available!\033[0m ({res.get('commits_behind')} commit(s) behind)")
            print(f"    Current commit: {res.get('current_commit')} | Remote: {res.get('remote_commit')}")
            print("\n  Changelog:")
            for c in res.get("changelog", []):
                print(f"    - {c['hash']}: {c['subject']} ({c['time']})")
            print("\n  Run 'phantom update' to apply.")
        else:
            print(f"\033[32m[+] PhantomNode OS is up to date (commit {res.get('current_commit')}).\033[0m")
    else:
        print("[*] Checking for PhantomNode OS updates...")
        check = system_mgr.check_for_updates()
        if not check.get("success"):
            print(f"\033[31m[!] Error: {check.get('error')}\033[0m")
            return
        if not check.get("update_available"):
            print(f"\033[32m[+] System is already up to date ({check.get('current_commit')}).\033[0m")
            return
        print(f"[*] Applying update ({check.get('commits_behind')} new commit(s))...")
        res = system_mgr.apply_update()
        if res.get("success"):
            print("\033[32m[+] Successfully updated PhantomNode OS!\033[0m")
            print("[*] System services are restarting.")
        else:
            print(f"\033[31m[!] Update failed: {res.get('error')}\033[0m")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        show_help()
        return

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == "status":
        cmd_status()
    elif cmd == "app":
        cmd_app(args)
    elif cmd == "onion":
        cmd_onion()
    elif cmd == "opsec":
        cmd_opsec(args)
    elif cmd == "update":
        cmd_update(args)
    else:
        show_help()

if __name__ == "__main__":
    main()
